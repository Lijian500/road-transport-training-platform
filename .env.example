# 复制为 .env 后再填写本地值；不得提交真实密码或密钥。
COMPOSE_PROJECT_NAME=road-training
TZ=Asia/Shanghai

# 基础设施镜像版本
MYSQL_VERSION=8.4
REDIS_VERSION=7.4-alpine
RABBITMQ_VERSION=4.1-management
NACOS_VERSION=v3.0.3
NGINX_VERSION=1.28-alpine

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_ADMIN_DATABASE=road_training_admin
MYSQL_TRAINING_DATABASE=road_training_training
MYSQL_LEARNING_DATABASE=road_training_learning
MYSQL_ADMIN_USER=train_admin
MYSQL_ADMIN_PASSWORD=change-me-admin
MYSQL_TRAINING_USER=train_training
MYSQL_TRAINING_PASSWORD=change-me-training
MYSQL_LEARNING_USER=train_learning
MYSQL_LEARNING_PASSWORD=change-me-learning

REDIS_PASSWORD=change-me-redis
RABBITMQ_DEFAULT_USER=train
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# 宿主机暴露端口
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_CONSOLE_PORT=8088
NACOS_SERVER_PORT=8848
NACOS_GRPC_PORT=9848
NGINX_HTTP_PORT=80

NACOS_AUTH_TOKEN=replace-with-base64-token-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-nacos-identity

JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=
JWT_ISSUER=road-transport-training
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
JWT_SECURE_COOKIE=false

# 平台超管仅在显式开启时幂等初始化；密码必须通过本地环境变量填写。
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=平台超级管理员

# OpenCV YuNet + SFace本地人脸模型；运行下载脚本后按实际启动目录填写绝对路径。
FACE_ENABLED=false
FACE_DETECTION_MODEL_PATH=
FACE_RECOGNITION_MODEL_PATH=
FACE_DETECTION_SCORE_THRESHOLD=0.9
FACE_NMS_THRESHOLD=0.3
FACE_TOP_K=5000
FACE_SIMILARITY_THRESHOLD=0.363
FACE_MAX_IMAGE_BYTES=10485760
FACE_MAX_IMAGE_PIXELS=25000000
