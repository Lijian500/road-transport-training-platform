root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,ts,vue,xml,java,properties,sql}]
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_size = 4
