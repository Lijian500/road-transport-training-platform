{
  "openapi": "3.0.3",
  "info": {
    "title": "培训档案、监管与车辆扩展API",
    "version": "0.1.0",
    "description": "本文件仅覆盖本次新增接口。登录、学习、考试等既有接口见同目录说明。写操作须在Cookie认证基础上携带X-XSRF-TOKEN。"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/training/student/overview": {
      "get": {
        "summary": "学员首页只读概览",
        "description": "需要权限：student:plan:view。租户和本人范围从登录上下文取得。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "统一Result业务响应；调用方必须检查code是否为SUCCESS。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Overview"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "尚未登录或会话失效"
          },
          "403": {
            "description": "权限或归属校验未通过"
          }
        }
      }
    },
    "/training/student/records": {
      "get": {
        "summary": "本人历史档案分页",
        "description": "需要权限：student:plan:view。租户和本人范围从登录上下文取得。",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "completionStatus",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "COMPLETED",
                "NOT_COMPLETED"
              ]
            }
          },
          {
            "name": "activity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "TO_STUDY",
                "TO_EXAM",
                "COMPLETED"
              ]
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一Result业务响应；调用方必须检查code是否为SUCCESS。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/RecordItemPage"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "尚未登录或会话失效"
          },
          "403": {
            "description": "权限或归属校验未通过"
          }
        }
      }
    },
